<Window x:Class="StageCue.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="StageCue" Width="1480" Height="920" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/><ColumnDefinition Width="318"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
<Border Grid.Column="0" Grid.RowSpan="3" Background="#20252B" BorderBrush="#39424C" BorderThickness="0,0,1,0"><DockPanel Margin="15,20"><StackPanel DockPanel.Dock="Top">
<Grid Margin="4,2,0,30"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="9" Background="#4B8DCE"><TextBlock Text="S" FontSize="23" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="STAGECUE" FontSize="16" FontWeight="Bold"/><TextBlock Text="SHOW CONTROL" FontSize="9" Foreground="#9BA8B5"/></StackPanel></Grid>
<TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Style="{StaticResource SectionLabel}" Margin="5,0,0,9"/><Button Content="⌂   Главная" Style="{StaticResource NavButton}" Click="NavHome_Click"/><Button Content="▤   Моя лента" Style="{StaticResource NavButton}" Click="NavFeed_Click"/><Button Content="♫   Фонотека" Style="{StaticResource NavButton}" Click="NavLibrary_Click"/><TextBlock Text="УПРАВЛЕНИЕ" Style="{StaticResource SectionLabel}" Margin="5,25,0,9"/><Button Content="⌘   Бинды клавиш" Style="{StaticResource NavButton}" Click="NavKeys_Click"/><Button Content="⚙   Настройки" Style="{StaticResource NavButton}" Click="NavSettings_Click"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,2"><Border Height="1" Background="#39424C" Margin="0,0,0,12"/><TextBlock Text="STAGE MODE" FontSize="9" FontWeight="Bold" Foreground="#8291A0"/><TextBlock Text="Локальная фонотека" FontSize="11" Foreground="#C1CAD3" Margin="0,5,0,0"/><TextBlock Text="Версия 0.3.0" FontSize="10" Foreground="#8291A0"/></StackPanel></DockPanel></Border>
<Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Background="#252B32" BorderBrush="#39424C" BorderThickness="0,0,0,1" Padding="22,14"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><Border Width="54" Height="54" CornerRadius="7" Background="#394653"><TextBlock Text="♫" FontSize="29" Foreground="#9CB9D6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0"><TextBlock x:Name="NowTitle" Text="Ничего не играет" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowSub" Text="Выбери фонограмму в фонотеке" FontSize="11" Foreground="#9BA8B5" Margin="0,4,0,0"/><TextBlock Text="STAGECUE • ЛОКАЛЬНОЕ ВОСПРОИЗВЕДЕНИЕ" FontSize="9" Foreground="#718091" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,22,0"><Button Content="↶" Width="36" Height="34" Click="RestartButton_Click"/><Button Content="■" Width="36" Height="34" Margin="5,0" Click="StopButton_Click"/><Button x:Name="PlayButton" Content="▶" Width="48" Height="42" Margin="5,0" FontSize="17" Background="#4B8DCE" Click="PlayButton_Click"/></StackPanel><StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="ГРОМКОСТЬ" FontSize="9" Foreground="#8F9BA8" FontWeight="Bold"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.8" ValueChanged="VolumeSlider_ValueChanged"/></StackPanel></Grid><Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="16"/></Grid.RowDefinitions><Slider x:Name="TimelineSlider" Grid.Row="0" Minimum="0" Maximum="1000" Value="0" IsMoveToPointEnabled="True" ValueChanged="TimelineSlider_ValueChanged" PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp" PreviewKeyUp="TimelineSlider_PreviewKeyUp"/><Grid Grid.Row="1"><TextBlock x:Name="TimelineTime" Text="00:00 / 00:00" FontSize="9" Foreground="#8F9BA8"/><TextBlock x:Name="CueTime" Text="Cue: не задана" FontSize="9" Foreground="#76A9D8" HorizontalAlignment="Right"/></Grid></Grid></Grid></Border>
<Grid Grid.Column="1" Grid.Row="1" Margin="20,16,15,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid Margin="2,0,2,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="РАБОЧАЯ ОБЛАСТЬ" FontSize="9" FontWeight="Bold" Foreground="#8190A0"/><TextBlock Text="Фонотека" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="＋ Добавить фонограммы" VerticalAlignment="Center" Background="#4B8DCE" Click="NavLibrary_Click"/></Grid><Frame x:Name="PageFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Background="Transparent"/></Grid>
<Border Grid.Column="2" Grid.Row="1" Background="#252B32" BorderBrush="#39424C" BorderThickness="1,0,0,0" Padding="14,17"><DockPanel><StackPanel DockPanel.Dock="Top"><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PLAYLIST" FontSize="9" FontWeight="Bold" Foreground="#8190A0"/><TextBlock Text="Очередь фонограмм" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="PlaylistCount" Grid.Column="1" Text="0" Foreground="#76A9D8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/></Grid><Border Height="1" Background="#3B4651" Margin="0,0,0,10"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="Один щелчок выбирает трек. Двойной щелчок запускает." FontSize="10" Foreground="#8190A0" TextWrapping="Wrap" Margin="2,12,2,0"/><ListBox x:Name="PlaylistList" ItemsSource="{Binding Tracks}" Background="Transparent" BorderThickness="0" SelectionChanged="PlaylistList_SelectionChanged" MouseDoubleClick="PlaylistList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="#303943" CornerRadius="5" Padding="9,10" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Number, StringFormat={}{0:00}}" Foreground="#76A9D8" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="#E2E7EC" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" Foreground="#8996A4" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Background="#20252B" BorderBrush="#39424C" BorderThickness="0,1,0,0" Padding="18,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="STAGECUE • SHOW CONTROL" FontSize="9" FontWeight="Bold" Foreground="#8190A0"/><TextBlock Text="Пробел — пауза  •  Enter — с начала  •  Ctrl+Пробел — cue point" FontSize="10" Foreground="#B5C0CA" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" x:Name="StatusText" Text="ГОТОВ К РАБОТЕ" Foreground="#76A9D8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/><TextBlock Grid.Column="2" Text="GRAPHITE BLUE" Foreground="#8190A0" FontSize="9" VerticalAlignment="Center"/></Grid></Border>
</Grid></Window>