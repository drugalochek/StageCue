<Window x:Class="StageCue.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="StageCue" Icon="Glossy Blue Monogram Emblem.ico" Width="1480" Height="900" MinWidth="1080" MinHeight="680"
 WindowStartupLocation="CenterScreen" Background="#080808" Foreground="#F0F0F0">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Grid.Row="0" MinHeight="228" Background="#101010" BorderBrush="#171717" BorderThickness="0,0,0,1" Padding="12,8">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="42"/><RowDefinition Height="18"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Top">
     <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <Image Source="Glossy Blue Monogram Emblem.ico" Width="26" Height="26" Stretch="Uniform"/>
      <TextBlock Text="STAGECUE" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,0,0"/>
     </StackPanel>
     <Border Width="116" Height="116" Background="#080808" BorderBrush="#333333" BorderThickness="1" HorizontalAlignment="Left">
      <Grid><Image x:Name="NowCoverImage" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/><TextBlock x:Name="NowCoverFallback" Text="♫" FontSize="43" Foreground="#7E8992" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
     </Border>
    </StackPanel>
    <Grid Grid.Row="0" Grid.Column="1" Margin="10,0,8,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="NowTitle" Text="Ничего не играет" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="NowSub" Grid.Row="1" Text="Выбери фонограмму в фонотеке" FontSize="12" Foreground="#B8B8B8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Row="2" Text="STAGECUE • SHOW CONTROL" FontSize="9" Foreground="#87929B" Margin="0,4,0,0"/>
     <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2">
      <Button x:Name="RepeatButton" Content="↻" Width="36" Height="30" Margin="3,0" Click="RepeatButton_Click" ToolTip="Повтор: выкл. / один трек"/>
      <Button x:Name="AutoNextButton" Content="AUTO NEXT ✓" Width="96" Height="30" Margin="3,0" FontSize="9" Click="AutoNextButton_Click" ToolTip="Автопереход к следующей фонограмме: включён"/>
      <Button Content="|◀" Width="38" Height="30" Margin="3,0" Click="PreviousButton_Click" ToolTip="Предыдущая фонограмма"/>
      <Button Content="■" Width="38" Height="30" Margin="3,0" Click="StopButton_Click" ToolTip="Стоп"/>
      <Button x:Name="PlayButton" Content="▶" Width="48" Height="34" Margin="3,0" FontSize="17" Background="#292929" Click="PlayButton_Click" ToolTip="Играть / пауза"/>
      <Button Content="Ⅱ" Width="38" Height="30" Margin="3,0" Click="PlayButton_Click" ToolTip="Пауза"/>
      <Button Content="▶|" Width="38" Height="30" Margin="3,0" Click="NextButton_Click" ToolTip="Следующая фонограмма"/>
      <Button x:Name="ShuffleButton" Content="⤢" Width="36" Height="30" Margin="3,0" Click="ShuffleButton_Click" ToolTip="Перемешивание"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Top" Margin="4,5,2,0">
     <TextBlock Text="ГРОМКОСТЬ" FontSize="9" Foreground="#A5ADB4" HorizontalAlignment="Right"/>
     <Slider x:Name="VolumeSlider" Width="150" Minimum="0" Maximum="1" Value="0.8" ValueChanged="VolumeSlider_ValueChanged" HorizontalAlignment="Right" Margin="0,7,0,0"/>
     <TextBlock Text="ВЫХОД: ПО УМОЛЧАНИЮ" FontSize="8" Foreground="#808A92" HorizontalAlignment="Right" Margin="0,5,0,0"/>
     <TextBlock x:Name="TimelineTime" Text="00:00 / 00:00" FontSize="10" Foreground="#B8B8B8" HorizontalAlignment="Right" Margin="0,14,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="WAVEFORM" FontSize="8" Foreground="#89939B" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <Canvas x:Name="WaveformCanvas" Grid.Column="1" Height="37" Background="#080808" ClipToBounds="True" MouseLeftButtonDown="WaveformCanvas_MouseLeftButtonDown" SizeChanged="WaveformCanvas_SizeChanged" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="2" x:Name="CueTime" Text="CUE: --:--" FontSize="9" Foreground="#6FA7D8" VerticalAlignment="Center" Margin="10,0,0,0"/>
    </Grid>
    <Grid Grid.Row="2" Grid.ColumnSpan="3">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="CTRL + ПРОБЕЛ — СОХРАНИТЬ ТОЧКУ СТАРТА И ЗАПУСТИТЬ" FontSize="8" Foreground="#78838A" VerticalAlignment="Bottom"/>
     <Slider x:Name="TimelineSlider" Grid.Column="1" Width="1" Height="1" Opacity="0" Minimum="0" Maximum="1000" Value="0" ValueChanged="TimelineSlider_ValueChanged" PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp" PreviewKeyUp="TimelineSlider_PreviewKeyUp"/>
    </Grid>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="#171717" BorderBrush="#303030" BorderThickness="0,0,0,1">
   <DockPanel>
    <StackPanel Orientation="Horizontal">
     <Button Content="Локальные файлы" Style="{StaticResource NavButton}" Click="NavLibrary_Click" Padding="12,5"/>
     <Button Content="Закладки" Style="{StaticResource NavButton}" Click="NavFeed_Click" Padding="12,5"/>
     <Button Content="Моя лента" Style="{StaticResource NavButton}" Click="NavFeed_Click" Padding="12,5"/>
     <Button Content="Бинды клавиш" Style="{StaticResource NavButton}" Click="NavKeys_Click" Padding="12,5"/>
     <Button Content="Настройки" Style="{StaticResource NavButton}" Click="NavSettings_Click" Padding="12,5"/>
    </StackPanel>
    <TextBlock Text="STAGECUE  /  LOCAL MUSIC LIBRARY" Foreground="#87919A" FontSize="8" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2" Background="#080808">
   <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#101010" BorderBrush="#41474D" BorderThickness="0,0,1,0" Padding="8,10">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="ФИЛЬТРЫ" FontSize="9" FontWeight="Bold" Foreground="#89939B" Margin="4,0,0,12"/>
     <StackPanel>
      <Button Content="Все файлы" Style="{StaticResource NavButton}" Click="NavLibrary_Click"/>
      <Button Content="По исполнителю" Style="{StaticResource NavButton}" Click="NavLibrary_Click"/>
      <Button Content="По альбому" Style="{StaticResource NavButton}" Click="NavLibrary_Click"/>
      <Button Content="Назначенные" Style="{StaticResource NavButton}" Click="NavLibrary_Click"/>
      <Border Height="1" Background="#41474D" Margin="4,12"/>
      <TextBlock Text="БЫСТРЫЙ ДОСТУП" FontSize="8" FontWeight="Bold" Foreground="#89939B" Margin="4,3,0,7"/>
      <TextBlock Text="1–0  Треки 01–10" FontSize="10" Foreground="#D0D0D0" Margin="4,3"/>
      <TextBlock Text="Alt  Треки 11–20" FontSize="10" Foreground="#D0D0D0" Margin="4,3"/>
      <TextBlock Text="Ctrl  Треки 21–30" FontSize="10" Foreground="#D0D0D0" Margin="4,3"/>
      <TextBlock Text="Ctrl+Alt  Треки 31–40" FontSize="10" Foreground="#D0D0D0" TextWrapping="Wrap" Margin="4,3"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="4,0,0,2"><TextBlock Text="STAGE MODE" FontSize="8" FontWeight="Bold" Foreground="#78838A"/><TextBlock Text="Версия 0.3.0" FontSize="9" Foreground="#9BA4AC" Margin="0,4,0,0"/></StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#181818" BorderBrush="#41474D" BorderThickness="0,0,0,1" Padding="8,0">
     <DockPanel><TextBlock Text="ФОНОТЕКА / ВСЕ ФАЙЛЫ" FontSize="9" Foreground="#D0D0D0" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="＋" Width="27" Height="24" Padding="0" Background="#292929" Click="AddFilesButton_Click" ToolTip="Добавить фонограммы"/></DockPanel>
    </Border>
    <Frame x:Name="PageFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Background="Transparent"/>
   </Grid>
   <Border Grid.Column="2" Background="#111111" BorderBrush="#41474D" BorderThickness="1,0,0,0">
    <DockPanel>
     <Grid DockPanel.Dock="Top" Background="#181818" Height="40">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="ПЛЕЙЛИСТ" FontSize="10" FontWeight="Bold" Foreground="#D2D7DC" VerticalAlignment="Center" Margin="11,0,0,0"/>
      <TextBlock x:Name="PlaylistCount" Grid.Column="1" Text="0" Foreground="#76A9D8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
     </Grid>
     <TextBlock DockPanel.Dock="Bottom" Text="＋ Добавить     － Удалить     ⋯ Меню" FontSize="9" Foreground="#B4BEC7" Background="#292929" Padding="8,8"/>
     <ListBox x:Name="PlaylistList" ItemsSource="{Binding Tracks}" Background="Transparent" BorderThickness="0" Padding="3" SelectionChanged="PlaylistList_SelectionChanged" MouseDoubleClick="PlaylistList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate>
       <Border Background="#171717" Padding="7,6" Margin="1,1">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <CheckBox IsChecked="True" VerticalAlignment="Top" IsHitTestVisible="False" Focusable="False" Margin="0,1,0,0"/>
         <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="#AAB4BC" FontSize="9" VerticalAlignment="Top"/>
         <StackPanel Grid.Column="2" Margin="3,0,0,0"><TextBlock Text="{Binding Name}" Foreground="#E2E6E9" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" Foreground="#89949D" FontSize="8" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
         <TextBlock Grid.Column="3" Text="•••••" Foreground="#8D979F" FontSize="8" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </Grid>
       </Border>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="#292929" Padding="8,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="QuickSearch" Background="#242424" BorderThickness="0" Foreground="White" Padding="6,2" VerticalAlignment="Center" Width="250" HorizontalAlignment="Left" ToolTip="Быстрый поиск" />
    <TextBlock Grid.Column="1" x:Name="StatusText" Text="ГОТОВ К РАБОТЕ" Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
    <TextBlock Grid.Column="2" Text="STAGECUE" Foreground="#EAF3FB" FontSize="9" VerticalAlignment="Center"/>
   </Grid>
  </Border>
 </Grid>
</Window>