<Application x:Class="StageCue.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <Color x:Key="Bg">#111722</Color><Color x:Key="Panel">#192231</Color><Color x:Key="Panel2">#202C3D</Color>
  <Color x:Key="Accent">#4D9BFA</Color><Color x:Key="TextMain">#F0F4FA</Color><Color x:Key="Muted">#91A0B4</Color>
  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}"/><SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}"/>
  <SolidColorBrush x:Key="Panel2Brush" Color="{StaticResource Panel2}"/><SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextMain}"/><SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>
  <Style x:Key="SectionLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#91A0B4"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Foreground" Value="#AEB7C3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="13,12"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#202C3D"/><Setter Property="Foreground" Value="#F4F6F8"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#2B3A4E"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F0F4FA"/><Setter Property="Background" Value="#26364A"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="13,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value=".82"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value=".65"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#192638"/><Setter Property="Foreground" Value="#F0F4FA"/><Setter Property="BorderBrush" Value="#34465D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#141D2A"/><Setter Property="BorderBrush" Value="#303A48"/><Setter Property="Foreground" Value="#F0F4FA"/><Setter Property="Padding" Value="5"/></Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="#4D9BFA"/><Setter Property="Margin" Value="0,3"/></Style>
 </Application.Resources>
</Application>