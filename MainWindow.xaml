<Window x:Class="StageCue.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="StageCue" Width="1320" Height="850" MinWidth="1050" MinHeight="700"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#11151E" BorderBrush="#252C38" BorderThickness="0,0,1,0">
   <DockPanel LastChildFill="True" Margin="17,20,17,16">
    <StackPanel DockPanel.Dock="Top">
     <Grid Margin="5,3,0,34">
      <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="42" Height="42" CornerRadius="13" Background="#D8FF5F" VerticalAlignment="Center">
       <TextBlock Text="S" FontSize="25" FontWeight="Black" Foreground="#15191F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="STAGECUE" FontSize="17" FontWeight="Bold" Foreground="#F4F5F7"/>
       <TextBlock Text="SHOW CONTROL" FontSize="9" FontWeight="SemiBold" Foreground="#778292" Margin="0,3,0,0"/>
      </StackPanel>
     </Grid>
     <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Style="{StaticResource SectionLabel}" Margin="8,0,0,10"/>
     <Button x:Name="NavHome" Content="⌂   Главная" Style="{StaticResource NavButton}" Click="NavHome_Click"/>
     <Button x:Name="NavFeed" Content="▤   Моя лента" Style="{StaticResource NavButton}" Click="NavFeed_Click"/>
     <Button x:Name="NavLibrary" Content="♫   Фонотека" Style="{StaticResource NavButton}" Click="NavLibrary_Click"/>
     <TextBlock Text="УПРАВЛЕНИЕ" Style="{StaticResource SectionLabel}" Margin="8,25,0,10"/>
     <Button x:Name="NavKeys" Content="⌘   Бинды клавиш" Style="{StaticResource NavButton}" Click="NavKeys_Click"/>
     <Button x:Name="NavSettings" Content="⚙   Настройки" Style="{StaticResource NavButton}" Click="NavSettings_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="5,0,5,3">
     <Border Height="1" Background="#29313D" Margin="0,0,0,13"/>
     <TextBlock Text="STAGE MODE" FontSize="9" FontWeight="Bold" Foreground="#7B8796"/>
     <TextBlock Text="Локальная фонотека" FontSize="11" Foreground="#AAB3BF" Margin="0,5,0,0"/>
     <TextBlock Text="Версия 0.2.0" FontSize="10" Foreground="#586373" Margin="0,3,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="27,22,27,22">
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="3,0,3,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="ПУЛЬТ УПРАВЛЕНИЯ" FontSize="10" FontWeight="Bold" Foreground="#7D8998"/>
     <TextBlock Text="Сцена под контролем" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/>
    </StackPanel>
    <Border Grid.Column="1" Background="#1B222D" CornerRadius="9" Padding="13,8" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <Ellipse Width="7" Height="7" Fill="#D8FF5F" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock Text="ГОТОВ К РАБОТЕ" FontSize="10" FontWeight="Bold" Foreground="#D6DCE4"/>
     </StackPanel>
    </Border>
   </Grid>
   <Frame x:Name="PageFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Background="Transparent"/>
   <Border Grid.Row="2" Background="#171D27" BorderBrush="#303A48" BorderThickness="1" CornerRadius="15" Padding="17,13" Margin="0,17,0,0">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2.2*"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="СЕЙЧАС В ЭФИРЕ" FontSize="9" FontWeight="Bold" Foreground="#7F8B9A"/>
      <TextBlock x:Name="NowTitle" Text="Ничего не играет" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
      <TextBlock x:Name="NowSub" Text="Выбери фонограмму в фонотеке" FontSize="11" Foreground="#8793A2" Margin="0,3,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
      <Button Content="↺" Width="39" Height="38" Padding="0" FontSize="17" Click="RestartButton_Click" ToolTip="Сначала"/>
      <Button x:Name="PlayButton" Content="▶" Width="48" Height="42" Margin="7,0" Padding="0" FontSize="17" Background="#D8FF5F" Foreground="#15191F" Click="PlayButton_Click"/>
     </StackPanel>
     <Grid Grid.Column="2" VerticalAlignment="Center">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Slider x:Name="TimelineSlider" Grid.Row="0" Minimum="0" Maximum="1000" Value="0" IsMoveToPointEnabled="True"
       ValueChanged="TimelineSlider_ValueChanged" PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp"
       PreviewKeyUp="TimelineSlider_PreviewKeyUp" ToolTip="Выбери момент воспроизведения"/>
      <Grid Grid.Row="1" Margin="0,4,0,0">
       <TextBlock x:Name="TimelineTime" Text="00:00 / 00:00" FontSize="10" Foreground="#8B97A5"/>
       <TextBlock x:Name="CueTime" Grid.Column="1" Text="Точка старта: не задана" FontSize="10" Foreground="#D8FF5F" HorizontalAlignment="Right"/>
      </Grid>
     </Grid>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>