<Window x:Class="StageCue.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="StageCue" Width="1480" Height="920" MinWidth="1180" MinHeight="760"
 WindowStartupLocation="CenterScreen" Background="#1D1F21" Foreground="#E2E4E7">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="184"/><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#242628" BorderBrush="#3A3D40" BorderThickness="0,0,0,1" Padding="14,10">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" VerticalAlignment="Top">
     <Grid Height="34" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Width="31" Height="31" CornerRadius="16" Background="#4B8DCE"><TextBlock Text="S" FontSize="21" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0"><TextBlock Text="STAGECUE" FontSize="14" FontWeight="Bold"/><TextBlock Text="SHOW CONTROL" FontSize="8" Foreground="#89939E"/></StackPanel>
     </Grid>
     <Border Width="88" Height="88" Background="#34383C" BorderBrush="#454A4F" BorderThickness="1" HorizontalAlignment="Left">
      <TextBlock Text="♫" FontSize="42" Foreground="#A7B8C9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </StackPanel>
    <Grid Grid.Column="1" Margin="8,0,16,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="NowTitle" Text="Ничего не играет" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="NowSub" Grid.Row="1" Text="Выбери фонограмму в фонотеке" FontSize="12" Foreground="#B1B8BF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Row="2" Text="STAGECUE • SHOW CONTROL • ЛОКАЛЬНЫЙ ФАЙЛ" FontSize="9" Foreground="#818A92" Margin="0,4,0,0"/>
     <Grid Grid.Row="3" Margin="0,5,0,0">
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="24"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Button Content="⤨" Width="35" Height="30" Margin="2" ToolTip="Режим воспроизведения"/>
       <Button Content="|◀" Width="38" Height="30" Margin="2" ToolTip="Предыдущий"/>
       <Button Content="■" Width="38" Height="30" Margin="2" Click="StopButton_Click" ToolTip="Стоп"/>
       <Button x:Name="PlayButton" Content="▶" Width="48" Height="34" Margin="3,0" FontSize="17" Background="#4B8DCE" Click="PlayButton_Click" ToolTip="Играть / пауза"/>
       <Button Content="Ⅱ" Width="38" Height="30" Margin="2" Click="PlayButton_Click" ToolTip="Пауза"/>
       <Button Content="▶|" Width="38" Height="30" Margin="2" ToolTip="Следующий"/>
       <Button Content="⤢" Width="35" Height="30" Margin="2" ToolTip="Перемешать"/>
      </StackPanel>
      <Grid Grid.Row="1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="CUE" FontSize="9" Foreground="#76A9D8" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <TextBlock Grid.Column="2" x:Name="CueTime" Text="Точка старта: не задана" FontSize="9" Foreground="#76A9D8" VerticalAlignment="Center"/>
      </Grid>
     </Grid>
    </Grid>
    <StackPanel Grid.Column="2" VerticalAlignment="Top">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <TextBlock Text="ГРОМКОСТЬ" FontSize="9" Foreground="#89939E" VerticalAlignment="Center" Margin="0,0,7,0"/>
      <Slider x:Name="VolumeSlider" Width="112" Minimum="0" Maximum="1" Value="0.8" ValueChanged="VolumeSlider_ValueChanged"/>
     </StackPanel>
     <TextBlock Text="ВЫХОД: ПО УМОЛЧАНИЮ" FontSize="9" Foreground="#89939E" HorizontalAlignment="Right" Margin="0,4,0,0"/>
     <TextBlock x:Name="TimelineTime" Text="00:00 / 00:00" FontSize="10" Foreground="#AAB2B9" HorizontalAlignment="Right" Margin="0,17,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,0">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="17"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Background="#303438" CornerRadius="2" Height="22" VerticalAlignment="Center">
      <Slider x:Name="TimelineSlider" Minimum="0" Maximum="1000" Value="0" IsMoveToPointEnabled="True" ValueChanged="TimelineSlider_ValueChanged" PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp" PreviewKeyUp="TimelineSlider_PreviewKeyUp" VerticalAlignment="Center" Margin="0,-2,0,0"/>
     </Border>
     <TextBlock Grid.Row="1" Text="CTRL + ПРОБЕЛ — СОХРАНИТЬ ТОЧКУ СТАРТА И ЗАПУСТИТЬ" FontSize="8" Foreground="#78828A" VerticalAlignment="Bottom"/>
    </Grid>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="#292C2F" BorderBrush="#3C4044" BorderThickness="0,0,0,1">
   <DockPanel LastChildFill="True">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
     <Button Content="Фонотека" Style="{StaticResource NavButton}" Click="NavLibrary_Click" Padding="13,5"/>
     <Button Content="Моя лента" Style="{StaticResource NavButton}" Click="NavFeed_Click" Padding="13,5"/>
     <Button Content="Бинды клавиш" Style="{StaticResource NavButton}" Click="NavKeys_Click" Padding="13,5"/>
     <Button Content="Настройки" Style="{StaticResource NavButton}" Click="NavSettings_Click" Padding="13,5"/>
    </StackPanel>
    <TextBlock Text="STAGECUE  /  LOCAL MUSIC LIBRARY" Foreground="#7E8992" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="318"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#25282B" BorderBrush="#3B3F43" BorderThickness="0,0,1,0" Padding="9,12">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="КАТЕГОРИИ" FontSize="9" FontWeight="Bold" Foreground="#87919A" Margin="4,0,0,12"/>
     <StackPanel>
      <Button Content="Все файлы" Style="{StaticResource NavButton}" Click="NavLibrary_Click"/>
      <Button Content="Назначенные" Style="{StaticResource NavButton}" Click="NavLibrary_Click"/>
      <Button Content="Быстрый запуск" Style="{StaticResource NavButton}" Click="NavFeed_Click"/>
      <Border Height="1" Background="#3B3F43" Margin="4,12"/>
      <TextBlock Text="СЦЕНИЧЕСКИЕ КОМАНДЫ" FontSize="8" FontWeight="Bold" Foreground="#87919A" Margin="4,4,0,8"/>
      <TextBlock Text="Пробел  Играть / пауза" FontSize="10" Foreground="#BEC5CB" TextWrapping="Wrap" Margin="4,3"/>
      <TextBlock Text="Enter  С начала" FontSize="10" Foreground="#BEC5CB" Margin="4,3"/>
      <TextBlock Text="Ctrl+Space  Cue point" FontSize="10" Foreground="#76A9D8" TextWrapping="Wrap" Margin="4,3"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="4,0,0,3"><TextBlock Text="STAGE MODE" FontSize="8" FontWeight="Bold" Foreground="#78838C"/><TextBlock Text="Версия 0.3.0" FontSize="9" Foreground="#9BA4AC" Margin="0,4,0,0"/></StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="0">
    <Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#2B2E31" BorderBrush="#3B3F43" BorderThickness="0,0,0,1" Padding="10,0">
     <DockPanel><TextBlock Text="ЛОКАЛЬНЫЕ ФАЙЛЫ  /  ФОНОТЕКА" FontSize="9" Foreground="#AAB2B9" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="＋ Добавить" Padding="10,3" Background="#4B8DCE" Click="AddFilesButton_Click"/></DockPanel>
    </Border>
    <Frame x:Name="PageFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Background="Transparent"/>
   </Grid>
   <Border Grid.Column="2" Background="#25282B" BorderBrush="#3B3F43" BorderThickness="1,0,0,0">
    <DockPanel>
     <Grid DockPanel.Dock="Top" Background="#292C2F" Height="43" Margin="0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="12,5" VerticalAlignment="Center"><TextBlock Text="PLAYLIST" FontSize="9" FontWeight="Bold" Foreground="#87919A"/><TextBlock Text="Очередь фонограмм" FontSize="12" Foreground="#D5D9DD"/></StackPanel>
      <TextBlock x:Name="PlaylistCount" Grid.Column="1" Text="0" Foreground="#76A9D8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,13,0"/>
     </Grid>
     <TextBlock DockPanel.Dock="Bottom" Text="Двойной щелчок: запуск  •  Ctrl+Space: точка старта" FontSize="9" Foreground="#818A92" TextWrapping="Wrap" Padding="10,9"/>
     <ListBox x:Name="PlaylistList" ItemsSource="{Binding Tracks}" Background="Transparent" BorderThickness="0" SelectionChanged="PlaylistList_SelectionChanged" MouseDoubleClick="PlaylistList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate>
       <Border Background="#303438" Padding="8,7" Margin="4,2">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Number}" Foreground="#76A9D8" FontSize="11" VerticalAlignment="Top" FontWeight="Bold"/>
         <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="#E2E4E7" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" Foreground="#89939C" FontSize="8" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
         <TextBlock Grid.Column="2" Text="•••" Foreground="#9BA4AC" FontSize="9" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </Grid>
       </Border>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="#4B8DCE" Padding="10,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="QuickSearch" Background="#3977B2" BorderThickness="0" Foreground="White" Padding="6,3" VerticalAlignment="Center" Width="250" HorizontalAlignment="Left" ToolTip="Быстрый поиск" />
    <TextBlock Grid.Column="1" x:Name="StatusText" Text="ГОТОВ К РАБОТЕ" Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
    <TextBlock Grid.Column="2" Text="STAGECUE" Foreground="#EAF3FB" FontSize="9" VerticalAlignment="Center"/>
   </Grid>
  </Border>
 </Grid>
</Window>